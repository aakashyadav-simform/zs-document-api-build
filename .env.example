# --- Connections ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=document_insights
REDIS_URL=redis://redis:6379/0

# --- Rate limiting ---
# Max documents a user may have queued/processing at once.
RATE_LIMIT_MAX=3
# Safety TTL (seconds) on the per-user counter so it cannot leak forever.
RATE_LIMIT_TTL_SECONDS=300

# --- Content cache ---
# How long a computed summary stays cached by content hash.
CACHE_TTL_SECONDS=86400

# --- Worker ---
WORKER_POLL_INTERVAL=1.0
WORKER_MIN_PROCESSING_SECONDS=10
WORKER_MAX_PROCESSING_SECONDS=30
# Fraction of jobs that randomly fail (0.1 = 10%).
FAILURE_RATE=0.1
# Total processing attempts before a job is marked failed.
MAX_ATTEMPTS=3
# A job stuck 'processing' longer than this is reclaimed (dead worker).
STALE_TIMEOUT_SECONDS=120
# Characters of content included in the mock summary.
SUMMARY_CHAR_LIMIT=500

# --- Logging ---
LOG_LEVEL=INFO
